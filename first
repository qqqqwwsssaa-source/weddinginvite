<!doctype html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Максим и Ангелина — приглашение</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Montserrat:wght@300;400;500&family=Great+Vibes&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#fbf2f1;
  --card:#ffffff;
  --rose-1:#f7e1df;
  --rose-2:#f1cfcc;
  --rose-3:#d9a7a2;
  --accent:#c9918b;
  --accent-dark:#93665f;
  --brown:#6f5143;
  --text:#2f2a28;
  --muted:#7a6b66;
  --shadow:0 20px 50px rgba(0,0,0,.08)
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);font-family:'Montserrat',sans-serif;color:var(--text);scroll-behavior:smooth}
.container{max-width:560px;margin:0 auto;background:var(--card);overflow:hidden;box-shadow:var(--shadow)}

.hero{position:relative;min-height:100svh;overflow:hidden;background:#d9aaa5}
.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}
.hero .overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.32) 0%,rgba(0,0,0,.08) 42%,rgba(0,0,0,.64) 100%)}
.hero .frame{position:absolute;inset:16px;border:1px solid rgba(255,255,255,.58);z-index:2}
.hero-top{position:absolute;top:52px;left:50%;transform:translateX(-50%);z-index:3;width:100%;text-align:center;padding:0 20px}
.script{font-family:'Cormorant Garamond',serif;font-size:clamp(42px,11vw,64px);font-weight:400;line-height:1.05;color:#fff3f1;text-shadow:0 6px 20px rgba(0,0,0,.38);max-width:92%;margin:0 auto}
.hero .content{position:absolute;left:0;right:0;bottom:54px;color:#fff;padding:0 28px;text-align:center;z-index:3}
.names{font-family:'Cormorant Garamond',serif;font-size:clamp(46px,12vw,74px);line-height:1;margin-top:8px;text-shadow:0 8px 24px rgba(0,0,0,.38);letter-spacing:.01em;white-space:nowrap}
.date-big{margin-top:20px;font-family:'Cormorant Garamond',serif;font-size:clamp(36px,9vw,56px);font-weight:400;line-height:1;color:#fff;letter-spacing:.08em;text-shadow:0 8px 24px rgba(0,0,0,.42)}

.wave{position:relative;background:linear-gradient(180deg,#f8e7e5 0%,#f3d8d5 100%);color:#5f4a43;text-align:center;padding:86px 26px 104px;overflow:hidden}
.wave svg.wave-line{position:absolute;top:-1px;left:0;width:100%}
.wave p{max-width:440px;margin:0 auto;line-height:1.95;font-size:16px;font-weight:300;color:#5f4a43;text-shadow:none;position:relative;z-index:2}
.beads{position:absolute;left:50%;top:38px;transform:translateX(-50%);display:flex;gap:9px;z-index:2}
.bead{width:8px;height:8px;border-radius:50%;background:#fff;box-shadow:0 2px 7px rgba(147,102,95,.18)}
.bead:nth-child(2),.bead:nth-child(6){width:11px;height:11px;background:#fdf7f6}.bead:nth-child(4){width:14px;height:14px;background:#fff}
.sticker-heart{position:absolute;right:24px;bottom:28px;width:52px;height:52px;transform:rotate(10deg);opacity:.58;z-index:1}
.sticker-star{position:absolute;left:26px;bottom:42px;width:40px;height:40px;transform:rotate(-12deg);opacity:.52;z-index:1}

.section{padding:64px 26px;text-align:center;position:relative;overflow:hidden;animation:softIn .9s ease both}
.section.alt{background:linear-gradient(180deg,#fff,#fff7f6)}
.section.rose{background:linear-gradient(180deg,var(--rose-1),#fff7f6)}
@keyframes softIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
h2{font-family:'Cormorant Garamond',serif;font-size:40px;margin:0 0 18px;color:#3a2f2c}
.text{font-size:16px;line-height:1.85;color:#514743;max-width:440px;margin:0 auto}
.div{width:110px;height:1px;background:var(--accent);opacity:.5;margin:18px auto;position:relative}
.div:before,.div:after{content:"";position:absolute;top:-3px;width:7px;height:7px;border-radius:50%;background:var(--accent)}
.div:before{left:30px}.div:after{right:30px}

.cal{max-width:440px;margin:12px auto 0;background:#fff;border-radius:32px;padding:22px 18px 24px;box-shadow:var(--shadow);border:1px solid #f0e3e2}
.cal-head{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:1px solid #efe2e1;padding-bottom:10px;margin-bottom:10px}
.cal-month{font-family:'Cormorant Garamond',serif;font-size:32px;color:var(--accent)}
.cal-year{font-size:12px;color:var(--muted);letter-spacing:.18em}
.week,.days{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}.week{font-size:10px;color:var(--muted);text-transform:uppercase}
.days span{min-height:34px;display:grid;place-items:center;font-size:13px;color:#5a504b;position:relative}.muted{opacity:.25}
.wed{font-weight:700;color:#7f5650;z-index:1}.wed svg{position:absolute;width:48px;height:43px;z-index:-1;filter:drop-shadow(0 5px 8px rgba(201,145,139,.16))}

.loc{max-width:440px;margin:0 auto;border-radius:30px;padding:26px;background:#fff;border:1px solid #efe2e1;box-shadow:var(--shadow)}
.btn{display:inline-block;margin-top:20px;padding:14px 28px;border-radius:999px;background:linear-gradient(135deg,var(--accent-dark),#d9aaa5);color:#fff;text-decoration:none;letter-spacing:.12em;text-transform:uppercase;font-size:12px;box-shadow:0 16px 32px rgba(201,145,139,.28);transition:.25s ease}
.btn:active{transform:scale(.97)}

.program{background:linear-gradient(180deg,#fff,#fff8f7)}
.modern-ornament{position:absolute;width:118px;height:210px;opacity:.24;top:48px;pointer-events:none}.modern-ornament.left{left:-30px}.modern-ornament.right{right:-30px;transform:scaleX(-1)}
.timeline{max-width:440px;margin:16px auto 0;border-left:1px solid rgba(201,145,139,.55);padding-left:24px;text-align:left;position:relative;z-index:2}
.t{position:relative;margin-bottom:21px}.t:last-child{margin-bottom:0}.t:before{content:"";position:absolute;left:-30px;top:4px;width:12px;height:12px;border-radius:50%;background:#fff;border:2px solid var(--accent);box-shadow:0 0 0 6px rgba(201,145,139,.12)}
.time{font-family:'Cormorant Garamond',serif;font-size:30px;color:#93665f;font-weight:600}.ev{font-size:15px;color:#4e4540;margin-top:4px}

.q{max-width:440px;margin:0 auto;background:#fff;border:1px solid #efe2e1;border-radius:32px;padding:36px 30px;box-shadow:var(--shadow);position:relative;overflow:hidden}
.wish-dots{position:absolute;top:18px;right:18px;display:flex;gap:7px}.wish-dots span{width:7px;height:7px;border-radius:50%;background:#f1cfcc}.wish-dots span:nth-child(2){background:#c9918b}.wish-dots span:nth-child(3){background:#f7e1df}
.wish-label{font-family:'Anastasia Script','Marck Script',cursive;color:var(--accent);font-size:38px;margin-bottom:-4px}
.bow{width:146px;margin:24px auto 0;display:block;filter:drop-shadow(0 12px 14px rgba(201,145,139,.16))}

.palette{max-width:440px;margin:20px auto 0;display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.sw{height:120px;border-radius:26px;display:flex;align-items:flex-end;justify-content:center;padding:10px;border:6px solid rgba(255,255,255,.85);box-shadow:var(--shadow)}.sw span{font-size:10px;color:#fff;text-shadow:0 1px 6px rgba(0,0,0,.28)}

.intro-title{font-family:'Cormorant Garamond',serif;font-size:38px;font-weight:400;margin:0 0 16px;color:#4d3d37}.intro-line{width:86px;height:1px;background:#c9918b;opacity:.42;margin:0 auto 20px}.rsvp-card{max-width:430px;margin:0 auto;background:#fff;border:1px solid #eedfdd;border-radius:34px;padding:36px 26px;box-shadow:var(--shadow)}
.rsvp-card h2{margin-bottom:10px}.rsvp-card .text{color:#6f5143}

.final{position:relative;background:#000}.final img{width:100%;display:block;filter:brightness(.78)}
.final .txt{position:absolute;left:50%;top:10%;transform:translateX(-50%);width:calc(100% - 54px);text-align:center;color:#fff8f6;font-family:'Great Vibes',cursive;font-weight:400;font-size:clamp(34px,10vw,60px);line-height:1.1;text-shadow:0 4px 18px rgba(0,0,0,.82)}.heart{margin-left:7px;color:#fff3f1}

@media(min-width:760px){body{padding:28px 0}.container{border-radius:30px}}
@media(max-width:390px){.section{padding:56px 22px}.palette{gap:8px}.sw{height:108px;border-width:4px;border-radius:22px}.sw span{font-size:9px}.hero-top{top:50px}.names{font-size:38px}.hero .content{padding:0 18px}.date-big{font-size:32px}.final .txt{top:9%;font-size:30px}.script{font-size:40px;max-width:90%}}.palette{gap:8px}.sw{height:108px;border-width:4px;border-radius:22px}.sw span{font-size:9px}.hero-top{top:44px}.names{font-size:42px}.hero .content{padding:0 20px}.date-big{font-size:34px}.final .txt{top:10%;font-size:42px}}
@media(prefers-reduced-motion:no-preference){.hero .content,.hero-top{animation:rise 1s ease both}.beads{animation:fade 1.3s ease both}.btn:hover{transform:translateY(-2px)}}
@keyframes rise{from{opacity:0;transform:translate(-50%,18px)}to{opacity:1;transform:translate(-50%,0)}}
@keyframes fade{from{opacity:0}to{opacity:1}}
</style>
</head>
<body>
<div class="container">

<section class="hero">
  <img src="https://drive.google.com/thumbnail?id=1hOqpFknAucrbtvM3-OTNuKiLxIAcHEnS&sz=w1600" alt="Максим и Ангелина">
